# ──────────────────────────────────────────────────────────────
# Meridian Bank — environment variables
# Copy this file to `.env` and adjust the values:
#   cp .env.example .env
# ──────────────────────────────────────────────────────────────

# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# Secret used to HMAC-sign session JWTs (HS256).
# Optional in development — a built-in dev fallback is used if unset.
# In production, set a long random value, e.g.:
#   openssl rand -hex 32
# Changing this invalidates all existing sessions.
AUTH_SECRET=""
